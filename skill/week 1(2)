        "import pandas as pd\n",
        "\n",
        "# File name\n",
        "CSV_PATH = \"Titanic-Dataset-selected-columns.csv\"\n",
        "\n",
        "# Read CSV file\n",
        "df = pd.read_csv(CSV_PATH)\n",
        "\n",
        "# 1. Display first 5 rows\n",
        "print(\"FIRST 5 ROWS\")\n",
        "print(df.head())\n",
        "\n",
        "# 2. Display dataset shape\n",
        "print(\"\\nDATASET SHAPE\")\n",
        "print(df.shape)\n",
        "\n",
        "# 3. Display column names\n",
        "print(\"\\nCOLUMN NAMES\")\n",
        "print(df.columns)\n",
        "\n",
        "# 4. Display data types\n",
        "print(\"\\nDATA TYPES\")\n",
        "print(df.dtypes)\n",
        "\n",
        "# 5. Display basic information\n",
        "print(\"\\nDATASET INFORMATION\")\n",
        "df.info()\n",
        "\n",
        "# 6. Display statistical summary\n",
        "print(\"\\nSTATISTICAL SUMMARY\")\n",
        "print(df.describe(include='all'))\n",
        "\n",
        "# 7. Check missing values\n",
        "print(\"\\nMISSING VALUES\")\n",
        "print(df.isnull().sum())\n",
        "\n",
        "# 8. Check duplicate rows\n",
        "print(\"\\nDUPLICATE ROWS\")\n",
        "print(df.duplicated().sum())\n",
        "\n",
        "# 9. Display Survived distribution\n",
        "print(\"\\nSURVIVED DISTRIBUTION\")\n",
        "print(df[\"Survived\"].value_counts())\n",
        "\n",
        "# 10. Display Survived percentage\n",
        "print(\"\\nSURVIVED PERCENTAGE\")\n",
        "print(df[\"Survived\"].value_counts(normalize=True) * 100)"
